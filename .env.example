# Headjack environment template. Copy to .env.local for local work; the server values are the instance's own, set in its Vercel project.
# Every value here is empty or an obvious placeholder. Never commit real values.

# --- Database (Neon Postgres) ---
# Pooled owner-role URL that the Neon integration injects; the app swaps in the headjack_app role and password.
DATABASE_URL=
# Direct (unpooled) owner-role URL; the Vercel build runs migrations over it in production and preview.
DATABASE_URL_UNPOOLED=
# Full app-role URL (role headjack_app); when set it wins over DATABASE_URL plus HEADJACK_APP_DB_PASSWORD.
DATABASE_URL_APP=
# Password of the headjack_app role, combined with DATABASE_URL to build the app-role URL.
HEADJACK_APP_DB_PASSWORD=
# Owner-role direct URL, given explicitly on the command line for db:migrate, db:baseline and set-app-password.
DATABASE_URL_OWNER=

# --- Authentication ---
# Clerk server key (sk_test_... or sk_live_...); Clerk sign-in stays off unless both Clerk keys are set.
CLERK_SECRET_KEY=
# Clerk publishable key (pk_test_... or pk_live_...).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Comma-separated origins Clerk session tokens may come from, e.g. https://headjack.example.invalid; HTTPS only,
# except http://localhost and http://127.0.0.1 (with any port) for local development.
CLERK_AUTHORIZED_PARTIES=

# --- Feature flags (Flags SDK with the Vercel adapter) ---
# Vercel Flags SDK key; the Vercel integration provides it.
FLAGS=
# Flags SDK secret (32 random bytes, base64) used to sign flag overrides and the Flags Explorer.
FLAGS_SECRET=

# --- Embeddings and enrichment (Vercel AI Gateway) ---
# AI Gateway key for local work; on Vercel the OIDC token below is used instead.
AI_GATEWAY_API_KEY=
# Vercel OIDC token, injected on Vercel and written by `vercel env pull` for local work.
VERCEL_OIDC_TOKEN=
# Embedding model id (default openai/text-embedding-3-small; the index expects 1536 dimensions).
EMBED_MODEL=
# Model id that writes example requests (English and Spanish) and tags for each skill (default openai/gpt-5-mini).
ENRICH_MODEL=

# --- Server jobs and telemetry ---
# Bearer secret Vercel Cron sends to /api/cron/check-upstream.
CRON_SECRET=
# GitHub token for upstream update checks (optional; raises the API rate limit).
GITHUB_TOKEN=
# HMAC key for the query hash in search exposure events; when empty, exposure logging is skipped.
SEARCH_EVENTS_HMAC_KEY=

# --- OAuth (CLI login on the REST API, and the MCP server) ---
# Clerk authorization-server origin shared by the REST API and the MCP server, e.g. https://clerk.example.invalid
HEADJACK_AUTH_SERVER_URL=
# Canonical HTTPS REST resource URL ending in /api, e.g. https://headjack.example.invalid/api; unset, REST refuses OAuth tokens.
HEADJACK_API_RESOURCE_URL=
# Public client id of the Clerk OAuth application that `headjack login` uses.
HEADJACK_CLI_CLIENT_ID=

# --- MCP server (read-only, behind the mcp-readonly flag) ---
# Canonical HTTPS resource URL ending in /mcp, e.g. https://headjack.example.invalid/mcp
MCP_RESOURCE_URL=
# Comma-separated exact origins allowed to POST /mcp.
MCP_ALLOWED_ORIGINS=
# Cursor-signing key, at least 32 bytes, generated privately.
MCP_CURSOR_SECRET=

# --- Maintenance scripts ---
# Owner id the maintenance scripts act as (default: the initial owner).
HEADJACK_OWNER_ID=
# Flag-override value pinning the control arm for `npm run search-eval -- --arm control`.
HEADJACK_OVERRIDE_CONTROL=
# Flag-override value pinning the bilingual arm for `npm run search-eval -- --arm bilingual`.
HEADJACK_OVERRIDE_BILINGUAL=
# Protected deployment that scripts/bypass-proxy.mjs forwards to, e.g. https://preview.example.invalid
TARGET=
# Vercel "Protection Bypass for Automation" value that scripts/bypass-proxy.mjs adds to each request.
VERCEL_AUTOMATION_BYPASS_SECRET=

# --- CLI (headjack) ---
# local (a SQLite vault at <state dir>/vault.db, no server; needs Node 22.16+ or 24+) or remote (the hosted server).
# Unset: remote when HEADJACK_URL is set, else local.
HEADJACK_MODE=
# Base URL of the Headjack instance you were invited to, e.g. https://headjack.example.invalid
HEADJACK_URL=
# The CLI's credential: an API key with skills:read (and skills:write for review/publish); overrides the token file.
HEADJACK_TOKEN=
# State directory (default ~/.headjack): token file, state.json, config.json, backups.
HEADJACK_HOME=
# Optional path to the local sqlite-vec extension; unset or empty uses cli/vendor/vec0.<platform>-<arch>.<dylib|so>.
# A missing or unloadable extension keeps search full text.
HEADJACK_VEC_PATH=
# Hours a local-mode upstream update check stays fresh before `updates` checks again (default 6; 0 checks every time).
HEADJACK_UPDATE_TTL_HOURS=
# Default --purpose for search: suggest, plan, manual, eval or warmup (default manual).
HEADJACK_PURPOSE=
# Set to any value to print the stack of an unexpected CLI error (otherwise one line).
HEADJACK_DEBUG=
# Path-delimiter-separated roots the CLI never imports from or installs into; overrides config.json excludedRoots.
HEADJACK_EXCLUDED_ROOTS=
# Milliseconds before `headjack mcp` gives up on one hosted request (a positive integer; default 30000).
HEADJACK_MCP_TIMEOUT_MS=
